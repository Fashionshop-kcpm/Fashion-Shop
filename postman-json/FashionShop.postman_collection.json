    {
      "name": "register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//  TEST 1 - Status code phải là 201\r",
              "pm.test(\"Status 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// TEST 2 - Response phải có token và thông tin user\r",
              "pm.test(\"Response có token và user\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"token\");\r",
              "    pm.expect(json).to.have.property(\"user\");\r",
              "    pm.expect(json.user).to.have.property(\"email\");\r",
              "    pm.environment.set(\"token\", json.token);\r",
              "});\r",
              "\r",
              "//  TEST 3 - kiểm tra field 'name' nhưng controller dùng 'fullname'\r",
              "pm.test(\"User có field 'name'\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.user).to.have.property(\"name\"); // ❌ sai: field đúng là 'fullname'\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"fullname\":\"Nguyễn Chí Trung\",\r\n    \"email\":\"chi16@gmail.com\",\r\n    \"phone\":\"0938019655\",\r\n    \"gender\":\"Nam\",\r\n    \"password\":\"Chi123\",\r\n    \"password_confirmation\":\"Chi123\"\r\n\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status 200\r",
              "pm.test(\"Status 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "//  Lưu token và kiểm tra message\r",
              "pm.test(\"Đăng nhập thành công và có token\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.message).to.equal(\"Đăng nhập thành công\");\r",
              "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;\r",
              "    pm.environment.set(\"token\", json.token);\r",
              "});\r",
              "// Kiểm tra API login chỉ trả đúng các trường dữ liệu được phép trong object user\r",
              "pm.test(\"User chỉ trả trường cần thiết\", function () {\r",
              "    const keys = Object.keys(pm.response.json().user);\r",
              "    const allowed = [\"id\", \"fullname\", \"email\", \"phone\", \"gender\"];\r",
              "    keys.forEach(k => pm.expect(allowed).to.include(k));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"test12@gmail.com\",\r\n    \"password\": \"123456\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
