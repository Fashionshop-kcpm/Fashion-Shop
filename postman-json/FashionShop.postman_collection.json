    {
      "name": "register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//  TEST 1 - Status code phải là 201\r",
              "pm.test(\"Status 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// TEST 2 - Response phải có token và thông tin user\r",
              "pm.test(\"Response có token và user\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"token\");\r",
              "    pm.expect(json).to.have.property(\"user\");\r",
              "    pm.expect(json.user).to.have.property(\"email\");\r",
              "    pm.environment.set(\"token\", json.token);\r",
              "});\r",
              "\r",
              "//  TEST 3 - kiểm tra field 'name' nhưng controller dùng 'fullname'\r",
              "pm.test(\"User có field 'name'\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.user).to.have.property(\"name\"); // ❌ sai: field đúng là 'fullname'\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"fullname\":\"Nguyễn Chí Trung\",\r\n    \"email\":\"chi16@gmail.com\",\r\n    \"phone\":\"0938019655\",\r\n    \"gender\":\"Nam\",\r\n    \"password\":\"Chi123\",\r\n    \"password_confirmation\":\"Chi123\"\r\n\r\n}",
